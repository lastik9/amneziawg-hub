# =====================================================================
#  awg.env  —  параметры туннеля AmneziaWG для setup-awg.sh
#  Скопируй в awg.env и заполни значениями из своего .conf:
#      cp awg.env.example awg.env && vi awg.env
#  Либо сгенерируй автоматически:  sh setup-awg.sh --from-conf my.conf
#  Значения в .conf идут без кавычек, здесь оборачивай в '...'
# =====================================================================

# --- имя интерфейса (site-узел меша: awg_hub; хаб остаётся awg0) ---
IFACE='awg_hub'

# --- [Interface] ---
PRIVATE_KEY='вставь_приватный_ключ'
ADDRESSES='10.0.0.2/32'                 # поле Address, несколько — через запятую
DNS='94.140.14.14,94.140.15.15'         # необязательно, можно оставить пустым ''
MTU='1280'

# --- obfuscation ([Interface]) ---
# Пусто = параметр не задаём (возьмётся дефолт драйвера).
JC='4'
JMIN='40'
JMAX='70'
S1='0'
S2='0'
S3='0'          # для AWG 2.0; для 1.5 оставь как в конфиге
S4='0'
H1='1'
H2='2'
H3='3'
H4='4'
# I1 — длинный hex-блоб. Вставляй ОДНОЙ строкой целиком, включая '<b 0x...>'
I1='<b 0x...>'

# --- [Peer] ---
PEER_PUBLIC_KEY='публичный_ключ_сервера'
PRESHARED_KEY=''                        # пусто если не используется
ENDPOINT_HOST='SERVER_IP_OR_HOST'
ENDPOINT_PORT='51820'
ALLOWED_IPS='0.0.0.0/0,::/0'
# KEEPALIVE: в .conf от Amnezia обычно пусто. За NAT (в т.ч. за вторым
# роутером) ОБЯЗАТЕЛЬНО поставь '25', иначе туннель будет засыпать.
KEEPALIVE='25'

# --- дорога A: AWG-фронт через локальный wstunnel client (опционально) ---
# Если этот узел заворачивает AWG в WSS через локальный wstunnel client, то
# AWG-пир должен смотреть на loopback, а НЕ на публичный IP хаба. Раскомментируй
# блок ниже И поставь ENDPOINT_HOST='127.0.0.1', ENDPOINT_PORT='51820' выше.
# (или сгенерируй всё разом:  sh setup-awg.sh --from-conf my.conf --wstunnel)
# WSTUNNEL_FRONT='1'             # включает пиннинг endpoint на loopback
# WSTUNNEL_LOCAL_PORT='51820'    # лок. udp-порт, на котором слушает wstunnel client
# HUB_WSS_HOST='138.16.178.138'  # реальный WSS-таргет хаба (для wstunnel/отката)
# HUB_WSS_PORT='443'

# --- firewall-зона ---
MAKE_ZONE='1'          # 1 = создать зону awg (masq+mss); 0 = не трогать фаервол
ZONE_NAME='awg'
